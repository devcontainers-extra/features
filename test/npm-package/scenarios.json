{
    "install_markdownlint_cli2": {
        "image": "debian:bookworm",
        "features": {
            "npm-package": {
                "version": "latest",
                "package": "markdownlint-cli2"
            }
        }
    },
    "install_angular_cli": {
        "image": "debian:bookworm",
        "features": {
            "npm-package": {
                "version": "latest",
                "package": "@angular/cli"
            }
        }
    },
    "install_typescript": {
        "image": "debian:bookworm",
        "features": {
            "npm-package": {
                "version": "latest",
                "package": "typescript"
            }
        }
    },
    "test_existing_installation": {
        "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
        "features": {
            "npm-package": {
                "version": "8.3.1",
                "package": "pnpm"
            }
        }
    },
    "test_existing_installation_different_version": {
        "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
        "features": {
            "npm-package": {
                "version": "7.26.3",
                "package": "pnpm"
            }
        }
    }
}